{
  "adapter": "example-coding-agent",
  "akbp": {
    "root_discovery": [
      "akbp.json"
    ],
    "preferred_transport": "jsonl-tool-server",
    "server_command": [
      "akbp-tool-server"
    ],
    "cli_command": "akbp",
    "startup": {
      "context_limit": 8,
      "require_capability_check": true
    },
    "writes": {
      "dry_run_first": true,
      "require_approval_for_scope": [
        "team",
        "public"
      ]
    },
    "write_policy": {
      "default_scope": "project",
      "dry_run_first": true,
      "require_review_metadata": true,
      "apply_requires_approved": true
    },
    "lifecycle": {
      "session_start_method": "akbp.session.start",
      "session_end_method": "akbp.session.end",
      "session_end_dry_run_first": true,
      "session_end_apply_requires_approved": true
    }
  }
}
