{
  "adapter": {
    "name": "gemini-cli",
    "type": "terminal-coding-agent",
    "version": "0.1.0"
  },
  "akbp": {
    "path": ".",
    "tool_server": {
      "command": "akbp-tool-server",
      "transport": "jsonl"
    },
    "startup_context_limit": 8,
    "write_policy": {
      "default_scope": "project",
      "dry_run_first": true,
      "require_review_metadata": true,
      "apply_requires_approved": true
    }
  }
}
