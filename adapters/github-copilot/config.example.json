{
  "adapter": {
    "name": "github-copilot",
    "type": "ide-agent",
    "version": "0.1.0"
  },
  "akbp": {
    "path": ".",
    "tool_server": {
      "command": "akbp-tool-server",
      "transport": "jsonl",
      "hosted_cloud_agent_default": "read_only"
    },
    "hosted_cloud_agent": {
      "requires_profiles": ["read_only"],
      "allowed_methods": [
        "akbp.capabilities",
        "akbp.status",
        "akbp.doctor",
        "akbp.query",
        "akbp.context",
        "akbp.search",
        "akbp.conformance",
        "akbp.export",
        "akbp.export_check",
        "akbp.audit",
        "akbp.cite",
        "akbp.source.verify",
        "akbp.import_check",
        "akbp.session.start"
      ],
      "blocked_write_methods": [
        "akbp.remember",
        "akbp.source.add",
        "akbp.ingest",
        "akbp.import_apply",
        "akbp.supersede",
        "akbp.contradict",
        "akbp.crystallize_session",
        "akbp.session.end",
        "akbp.index"
      ]
    },
    "startup_context_limit": 8,
    "write_policy": {
      "default_scope": "project",
      "dry_run_first": true,
      "require_review_metadata": true,
      "apply_requires_approved": true
    },
    "lifecycle": {
      "session_start_method": "akbp.session.start",
      "session_end_method": "akbp.session.end",
      "session_end_dry_run_first": true,
      "session_end_apply_requires_approved": true
    }
  }
}
