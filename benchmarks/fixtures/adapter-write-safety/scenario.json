        "status": "stable",
        "confidence": 0.9,
        "evidence": ["source_adapter_readme_policy", "source_agent_flow_write_boundary"],
        "entities": ["adapter", "akbp.capabilities", "akbp.context", "ingest", "dry_run", "akbp.session.end", "review_required", "apply_instruction", "approved:true"],
        "scope": "project"
      },
      {
        "id": "claim_adapters_must_not_store_sensitive_runtime_data",
        "text": "Adapters must not store secrets, tokens, cookies, auth headers, private DMs, or raw logs with credentials in durable knowledge.",
        "type": "warning",
        "status": "stable",
        "confidence": 0.9,
        "evidence": ["source_adapter_readme_policy"],
        "entities": ["adapter", "privacy", "secrets", "tokens", "cookies", "logs"],
        "scope": "project"
      }
    ],
