{
  "id": "adapter-write-safety-001",
  "task": "Ensure runtime adapters consistently enforce approval-gated durable writes instead of applying memory changes directly.",
  "setup": {
    "sources": [
      {
        "id": "source_adapter_config_policy",
        "type": "file",
        "locator": "adapters/*/config.example.json",
        "title": "Adapter write policy configuration"
      },
      {
        "id": "source_adapter_readme_policy",
        "type": "file",
        "locator": "adapters/*/README.md",
        "title": "Adapter approval-gated write safety guidance"
      },
      {
        "id": "source_agent_flow_write_boundary",
        "type": "file",
        "locator": "docs/AGENT_FLOW.md",
        "title": "Agent flow write boundary"
