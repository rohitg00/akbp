    "claims": [
      {
        "id": "claim_adapter_configs_require_approval_gate",
        "text": "Adapter configs must set project default scope, dry_run_first true, require_review_metadata true, and apply_requires_approved true for durable writes.",
        "type": "workflow",
        "status": "stable",
        "confidence": 0.9,
        "evidence": ["source_adapter_config_policy"],
        "entities": ["adapter", "config", "dry_run_first", "require_review_metadata", "apply_requires_approved", "project"],
        "scope": "project"
      },
      {
        "id": "claim_adapter_docs_require_review_boundary",
        "text": "Adapter docs must instruct clients to call capabilities, fetch context, start ingest dry-run, preview session-end lifecycle writes with dry_run, surface review_required and apply_instruction, and apply only with approved:true.",
