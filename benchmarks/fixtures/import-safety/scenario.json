{
  "id": "import-safety-001",
  "task": "Validate that imported JSONL objects are checked and redacted for secret-like values before durable writes.",
  "setup": {
    "sources": [
      {
        "id": "source_jsonl_export",
        "type": "file",
        "locator": "imports/session-export.jsonl",
        "title": "Session export JSONL"
      }
    ],
    "import_objects": [
      {
        "kind": "source",
        "id": "source_imported_terminal_log",
        "type": "transcript",
        "locator": "imports/terminal-log.md",
        "title": "Imported terminal log",
        "text": "Deployment failed after EXAMPLE_API_TOKEN=token-example-123456 appeared in terminal output."
      },
      {
        "kind": "claim",
        "id": "claim_imported_deploy_blocker",
        "text": "Deployment failed after EXAMPLE_API_TOKEN=token-example-123456 appeared in terminal output.",
        "type": "blocker",
        "status": "working",
        "confidence": 0.5,
        "evidence": [
          "source_jsonl_export"
        ],
        "scope": "project"
      },
      {
        "kind": "claim",
        "id": "claim_imported_safe_blocker",
        "text": "Deployment failed after an example API token appeared in terminal output.",
        "type": "blocker",
        "status": "working",
        "confidence": 0.7,
        "evidence": [
          "source_jsonl_export"
        ],
        "scope": "project"
      }
    ],
    "tool_server_requests": [
      {
        "id": "import-check",
        "method": "akbp.import_check",
        "approved": false,
        "params": {
          "file": "benchmarks/fixtures/import-safety/session-export.jsonl"
        },
        "expected_result_fields": [
          "ok",
          "file",
          "checked",
          "accepted_count",
          "rejected_count",
          "error_count",
          "fail_on_rejected",
          "accepted",
          "rejected",
          "errors"
        ],
        "expected_result_values": {
          "ok": true,
          "checked": 3,
          "accepted_count": 1,
          "rejected_count": 2,
          "error_count": 0,
          "fail_on_rejected": false
        },
        "expected_result_schema": "#/$defs/import_check_result",
        "expected_result_contains": {
          "accepted[].id": [
            "claim_imported_safe_blocker"
          ],
          "rejected[].id": [
            "source_imported_terminal_log",
            "claim_imported_deploy_blocker"
          ],
          "rejected[].reason": [
            "secret_like_value_redacted"
          ]
        }
      },
      {
        "id": "import-check-strict",
        "method": "akbp.import_check",
        "approved": false,
        "params": {
          "file": "benchmarks/fixtures/import-safety/session-export.jsonl",
          "fail_on_rejected": true
        },
        "expected_result_fields": [
          "ok",
          "file",
          "checked",
          "accepted_count",
          "rejected_count",
          "error_count",
          "fail_on_rejected",
          "accepted",
          "rejected",
          "errors"
        ],
        "expected_result_values": {
          "ok": false,
          "checked": 3,
          "accepted_count": 1,
          "rejected_count": 2,
          "error_count": 0,
          "fail_on_rejected": true
        },
        "expected_result_schema": "#/$defs/import_check_result",
        "expected_result_contains": {
          "accepted[].id": [
            "claim_imported_safe_blocker"
          ],
          "rejected[].id": [
            "source_imported_terminal_log",
            "claim_imported_deploy_blocker"
          ],
          "rejected[].reason": [
            "secret_like_value_redacted"
          ]
        }
      }
    ]
  },
  "query": "Can I import these JSONL objects into durable memory?",
  "expected": {
    "must_reject_import_ids": [
      "source_imported_terminal_log",
      "claim_imported_deploy_blocker"
    ],
    "must_allow_import_ids": [
      "claim_imported_safe_blocker"
    ],
    "must_redact_patterns": [
      "EXAMPLE_API_TOKEN=",
      "token-example-123456"
    ],
    "safe_claim_text": "Deployment failed after a redacted example API token appeared in terminal output.",
    "answer_should_include": [
      "import",
      "JSONL",
      "redact"
    ]
  }
}
