{
  "id": "invalid-param-rejection-001",
  "task": "Verify JSONL tool-server parameter validation rejects unknown, missing, and wrong-typed params before CLI execution.",
  "setup": {
    "sources": [
      {
        "id": "source_invalid_param_contract",
        "type": "file",
        "locator": "docs/TOOL_CONTRACT.md",
        "title": "Tool contract invalid parameter details"
      }
    ],
    "claims": [
      {
        "id": "claim_invalid_params_are_schema_backed",
        "text": "JSONL tool-server parameter validation returns schema-backed invalid_params details before executing CLI commands.",
        "type": "workflow",
        "status": "stable",
        "confidence": 0.9,
        "evidence": [
          "source_invalid_param_contract"
        ],
        "entities": [
          "invalid_params",
          "schema-backed",
          "JSONL"
        ],
        "scope": "project"
      }
    ],
    "tool_server_requests": [
      {
        "id": "search-params-not-object",
        "method": "akbp.search",
        "approved": false,
        "params": "not an object",
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "params must be an object"
          ]
        }
      },
      {
        "id": "search-unknown-param",
        "method": "akbp.search",
        "approved": false,
        "params": {
          "query": "release",
          "surprise": true
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "unknown",
          "allowed",
          "params_schema"
        ],
        "expected_error_values": {
          "unknown": [
            "surprise"
          ]
        },
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "allowed[]": [
            "query",
            "limit"
          ]
        }
      },
      {
        "id": "crystallize-missing-param",
        "method": "akbp.crystallize_session",
        "approved": false,
        "dry_run": true,
        "params": {},
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "missing",
          "params_schema"
        ],
        "expected_error_values": {
          "missing": [
            "transcript"
          ]
        },
        "expected_error_schema": "#/$defs/invalid_params_details"
      },
      {
        "id": "session-start-limit-range-error",
        "method": "akbp.session.start",
        "approved": false,
        "params": {
          "task": "adapter lifecycle",
          "limit": 0
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "limit must be between 1 and 100"
          ]
        }
      },
      {
        "id": "session-end-missing-param",
        "method": "akbp.session.end",
        "approved": false,
        "dry_run": true,
        "params": {},
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "missing",
          "params_schema"
        ],
        "expected_error_values": {
          "missing": [
            "transcript"
          ]
        },
        "expected_error_schema": "#/$defs/invalid_params_details"
      },
      {
        "id": "search-type-error",
        "method": "akbp.search",
        "approved": false,
        "params": {
          "query": "release",
          "limit": "5"
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "limit must be an integer"
          ]
        }
      },
      {
        "id": "search-query-too-long",
        "method": "akbp.search",
        "approved": false,
        "params": {
          "query": ""
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "query must be at most 4096 characters"
          ]
        }
      },
      {
        "id": "export-check-file-too-long",
        "method": "akbp.export_check",
        "approved": false,
        "params": {
          "file": ""
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "file must be at most 4096 characters"
          ]
        }
      },
      {
        "id": "import-check-file-too-long",
        "method": "akbp.import_check",
        "approved": false,
        "params": {
          "file": ""
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "file must be at most 4096 characters"
          ]
        }
      },
      {
        "id": "import-apply-file-too-long",
        "method": "akbp.import_apply",
        "approved": false,
        "params": {
          "file": ""
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "file must be at most 4096 characters"
          ]
        },
        "dry_run": true
      },
      {
        "id": "remember-evidence-item-type-error",
        "method": "akbp.remember",
        "approved": false,
        "params": {
          "text": "Record a cited claim",
          "evidence": [
            "source_invalid_param_contract",
            42
          ]
        },
        "expected_error_code": "invalid_params",
        "expected_error_fields": [
          "type_errors",
          "params_schema"
        ],
        "expected_error_schema": "#/$defs/invalid_params_details",
        "expected_error_contains": {
          "type_errors[]": [
            "evidence items must be strings"
          ]
        }
      },
      {
        "id": "remember-evidence-count-error",
        "method": "akbp.remember",
        "approved": false,
        "params": {
          "text": "Record a cited claim",
          "evidence": [
            "source_invalid_param_contract",
