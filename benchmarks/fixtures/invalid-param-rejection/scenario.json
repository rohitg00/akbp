  },
  "query": "How does the JSONL server reject invalid method params?",
  "expected": {
    "must_retrieve": [
      "claim_invalid_params_are_schema_backed"
    ],
    "must_cite": [
      "source_invalid_param_contract"
    ],
    "answer_should_include": [
      "invalid_params",
      "schema-backed",
      "JSONL"
    ]
  }
}
