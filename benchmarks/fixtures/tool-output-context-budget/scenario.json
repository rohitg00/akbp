        "expected_result_fields": ["query", "items", "quality", "budget", "warnings"],
        "expected_result_schema": "#/$defs/context_result",
        "expected_result_contains": {
          "items[].id": ["claim_tool_output_requires_bounded_cited_context"],
          "items[].citations[]": ["source_tool_output_budget_review"],
          "quality.ok": [true],
          "quality.require_citations": [true],
          "quality.budget_truncated": [true],
          "budget.max_chars": [180],
          "budget.truncated": [true]
        }
      }
    ]
  },
  "query": "tool protocol JSONL tool output startup context budget diagnostics citations",
  "expected": {
    "must_retrieve": ["claim_tool_output_requires_bounded_cited_context"],
    "must_cite": ["source_tool_output_budget_review"],
