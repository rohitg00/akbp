        "entities": [
          "tool-protocol",
          "jsonl-tool-server",
          "tool-output",
          "startup-context",
          "context-budget",
          "citations",
          "budget-diagnostics"
        ],
        "scope": "project"
      },
      {
        "id": "claim_raw_tool_traces_are_diagnostics_not_startup_context",
        "text": "Raw JSONL tool traces and tool-protocol audit logs are useful diagnostics, but adapters should keep them out of startup context unless a reviewed claim cites the relevant evidence.",
        "type": "policy",
        "status": "stable",
        "confidence": 0.86,
        "evidence": ["source_jsonl_tool_trace", "source_tool_protocol_audit_log"],
        "entities": [
          "raw-tool-trace",
          "tool-protocol-audit-log",
          "diagnostics",
          "reviewed-claim",
          "startup-context"
        ],
        "scope": "project"
      }
    ],
    "tool_server_requests": [
      {
        "id": "context-tool-output-budget",
        "method": "akbp.context",
        "params": {
          "task": "tool protocol JSONL tool output startup context budget diagnostics citations",
          "limit": 5,
          "max_chars": 180,
          "min_items": 1,
          "require_citations": true
