{
  "schema_version": "0.1-draft",
  "name": "level-1-example",
  "description": "AKBP structured claims and evidence example",
  "root": ".",
  "artifacts": {
    "wiki": "wiki/",
    "claims": "claims/claims.jsonl",
    "entities": "graph/entities.jsonl",
    "relations": "graph/relations.jsonl",
    "sources": "raw/sources/",
    "audit": ".akbp/audit.log.jsonl"
  },
  "capabilities": {
    "remember": true,
