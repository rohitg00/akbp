{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rohitg00/akbp/main/schemas/context-pack.schema.json",
  "title": "AKBP Context Pack",
  "type": "object",
  "required": ["query", "generated_at", "items", "quality"],
  "properties": {
    "query": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "summary"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["claim", "page", "entity", "relation", "source"] },
          "summary": { "type": "string" },
          "score": { "type": "number" },
          "backend": { "type": "string" },
          "citations": { "type": "array", "items": { "type": "string" } },
          "freshness": { "type": "string", "enum": ["fresh", "unknown", "stale"] }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["ok", "minimum_items", "require_citations", "items", "uncited_items", "failed"],
      "properties": {
        "ok": { "type": "boolean" },
        "minimum_items": { "type": "integer", "minimum": 0 },
        "require_citations": { "type": "boolean" },
        "items": { "type": "integer", "minimum": 0 },
        "uncited_items": { "type": "array", "items": { "type": "string" } },
        "failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_chars",
        "summary_chars",
        "original_summary_chars",
        "truncated",
        "truncated_items",
        "clipped_items",
        "omitted_items",
        "items_before_budget",
        "items_after_budget"
      ],
      "properties": {
        "max_chars": { "type": "integer", "minimum": 1 },
        "summary_chars": { "type": "integer", "minimum": 0 },
        "original_summary_chars": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "truncated_items": { "type": "integer", "minimum": 0 },
        "clipped_items": { "type": "integer", "minimum": 0 },
        "omitted_items": { "type": "integer", "minimum": 0 },
        "items_before_budget": { "type": "integer", "minimum": 0 },
        "items_after_budget": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
