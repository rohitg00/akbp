{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rohitg00/akbp/main/schemas/context-pack.schema.json",
  "title": "AKBP Context Pack",
  "type": "object",
  "required": ["query", "generated_at", "items"],
  "properties": {
    "query": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "summary"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["claim", "page", "entity", "relation", "source"] },
          "summary": { "type": "string" },
          "score": { "type": "number" },
          "backend": { "type": "string" },
          "citations": { "type": "array", "items": { "type": "string" } },
          "freshness": { "type": "string", "enum": ["fresh", "unknown", "stale"] }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_chars", "summary_chars", "original_summary_chars", "truncated_items"],
      "properties": {
        "max_chars": { "type": "integer", "minimum": 1 },
        "summary_chars": { "type": "integer", "minimum": 0 },
        "original_summary_chars": { "type": "integer", "minimum": 0 },
        "truncated_items": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
