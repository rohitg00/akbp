{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rohitg00/akbp/main/schemas/entity.schema.json",
  "title": "AKBP Entity",
  "type": "object",
  "required": ["id", "name", "type", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["person", "project", "repo", "company", "concept", "decision", "workflow", "file", "api", "incident", "source", "agent", "tool", "team", "system"] },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "page": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
