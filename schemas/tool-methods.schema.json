{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rohitg00/akbp/main/schemas/tool-methods.schema.json",
  "title": "AKBP Tool Method Parameters",
  "description": "Method-specific parameter schemas for the AKBP JSONL local tool server.",
  "$defs": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "evidenceList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "entityList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "akbp.query.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "akbp.context.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "akbp.remember.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "fact",
            "decision",
            "preference",
            "workflow",
            "observation",
            "question",
            "warning"
          ],
          "default": "observation"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "entity": {
          "$ref": "#/$defs/entityList"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.source.add.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "default": "file",
          "enum": [
            "file",
            "url",
            "transcript",
            "message",
            "commit",
            "issue",
            "screenshot",
            "pdf",
            "audio",
            "video",
            "folder"
          ]
        },
        "title": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.supersede.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_claim_id",
        "text"
      ],
      "properties": {
        "old_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "default": "observation",
          "enum": [
            "fact",
            "decision",
            "preference",
            "workflow",
            "observation",
            "question",
            "warning"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "entity": {
          "$ref": "#/$defs/entityList"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.contradict.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_claim_id",
        "target_claim_id"
      ],
      "properties": {
        "source_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "target_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.source.verify.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "fail_on_issue": { "type": "boolean", "default": false }
      }
    },
    "akbp.ingest.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "default": "file",
          "enum": [
            "file",
            "url",
            "transcript",
            "message",
            "commit",
            "issue",
            "screenshot",
            "pdf",
            "audio",
            "video",
            "folder"
          ]
        },
        "title": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "claim_type": {
          "type": "string",
          "default": "observation",
          "enum": [
            "fact",
            "decision",
            "preference",
            "workflow",
            "observation",
            "question",
            "warning"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "entity": {
          "$ref": "#/$defs/entityList"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.export_check.params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "fail_on_issues": { "type": "boolean", "default": false }
      }
    },
    "akbp.import_check.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "fail_on_rejected": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.import_apply.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.index.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incremental": {
          "type": "boolean",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "akbp.search.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "akbp.capabilities.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "akbp.status.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "akbp.conformance.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "0",
            "1",
            "2",
            "3"
          ],
          "default": "0"
        }
      }
    },
    "akbp.export.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "akbp.audit.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "akbp.cite.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "akbp.crystallize_session.params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcript"
      ],
      "properties": {
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "apply": {
          "type": "boolean",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "akbp.query": {
          "$ref": "#/$defs/akbp.query.params"
        },
        "akbp.context": {
          "$ref": "#/$defs/akbp.context.params"
        },
        "akbp.index": {
          "$ref": "#/$defs/akbp.index.params"
        },
        "akbp.search": {
          "$ref": "#/$defs/akbp.search.params"
        },
        "akbp.remember": {
          "$ref": "#/$defs/akbp.remember.params"
        },
        "akbp.source.add": {
          "$ref": "#/$defs/akbp.source.add.params"
        },
        "akbp.source.verify": {
          "$ref": "#/$defs/akbp.source.verify.params"
        },
        "akbp.ingest": {
          "$ref": "#/$defs/akbp.ingest.params"
        },
        "akbp.import_check": {
          "$ref": "#/$defs/akbp.import_check.params"
        },
        "akbp.import_apply": {
          "$ref": "#/$defs/akbp.import_apply.params"
        },
        "akbp.supersede": {
          "$ref": "#/$defs/akbp.supersede.params"
        },
        "akbp.contradict": {
          "$ref": "#/$defs/akbp.contradict.params"
        },
        "akbp.capabilities": {
          "$ref": "#/$defs/akbp.capabilities.params"
        },
        "akbp.status": {
          "$ref": "#/$defs/akbp.status.params"
        },
        "akbp.conformance": {
          "$ref": "#/$defs/akbp.conformance.params"
        },
        "akbp.export": {
          "$ref": "#/$defs/akbp.export.params"
        },
        "akbp.audit": {
          "$ref": "#/$defs/akbp.audit.params"
        },
        "akbp.cite": {
          "$ref": "#/$defs/akbp.cite.params"
        },
        "akbp.crystallize_session": {
          "$ref": "#/$defs/akbp.crystallize_session.params"
        }
      }
    }
  }
}
