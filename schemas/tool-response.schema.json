{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rohitg00/akbp/main/schemas/tool-response.schema.json",
  "title": "AKBP Tool Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ok",
    "result",
    "error"
  ],
  "properties": {
    "id": {
      "description": "Request identifier copied from the matching request when available.",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "description": "Method-specific response payload when ok is true, otherwise null.",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "error": {
      "description": "Structured error object when ok is false, otherwise null.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "anyOf": [
                {
                  "$ref": "#/$defs/approval_required_details"
                },
                {
                  "$ref": "#/$defs/unknown_method_details"
                },
                {
                  "$ref": "#/$defs/invalid_params_details"
                },
                {
                  "$ref": "#/$defs/invalid_request_details"
                },
                {
                  "$ref": "#/$defs/invalid_json_details"
                },
                {
                  "$ref": "#/$defs/cli_error_details"
                },
                {
                  "$ref": "#/$defs/internal_error_details"
                },
                {
                  "type": "object"
                },
                {
                  "type": "array"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "approval_required_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "dry_run",
        "review_required",
        "apply_instruction"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^akbp\\."
        },
        "dry_run": {
          "const": false
        },
        "review_required": {
          "const": true
        },
        "apply_instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dry_run_review_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run",
        "review_required",
        "apply_instruction",
        "method",
        "path",
        "argv",
        "would_write"
      ],
      "properties": {
        "dry_run": {
          "const": true
        },
        "review_required": {
          "const": true
        },
        "apply_instruction": {
          "type": "string",
          "minLength": 1
        },
        "would_write": {
          "const": true
        },
        "method": {
          "type": "string",
          "pattern": "^akbp\\."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "invalid_request_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "schema"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invalid_params_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "params_schema"
      ],
      "properties": {
        "params_schema": {
          "type": "string",
          "minLength": 1
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unknown_method_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_methods"
      ],
      "properties": {
        "available_methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "features",
        "schemas",
        "methods",
        "examples"
      ],
      "properties": {
        "protocol": {
          "const": "akbp-jsonl-tool-server"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structured_errors",
            "capability_discovery",
            "dry_run",
            "write_review_required",
            "write_apply_requires_approval",
            "jsonl_transport",
            "method_param_schemas",
            "unknown_param_rejection",
            "required_param_validation",
            "approval_required_errors"
          ],
          "properties": {
            "structured_errors": {
              "const": true
            },
            "capability_discovery": {
              "const": true
            },
            "dry_run": {
              "const": true
            },
            "write_review_required": {
              "const": true
            },
            "write_apply_requires_approval": {
              "const": true
            },
            "jsonl_transport": {
              "const": true
            },
            "method_param_schemas": {
              "const": true
            },
            "unknown_param_rejection": {
              "const": true
            },
            "required_param_validation": {
              "const": true
            },
            "approval_required_errors": {
              "const": true
            }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "response",
            "methods"
          ],
          "properties": {
            "request": {
              "type": "string",
              "minLength": 1
            },
            "response": {
              "type": "string",
              "minLength": 1
            },
            "methods": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "methods": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "write",
              "params",
              "review_required",
              "params_schema"
            ],
            "properties": {
              "write": {
                "type": "boolean"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "review_required": {
                "type": "boolean"
              },
              "params_schema": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "pattern": "^akbp\\."
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "dry_run": {
                "type": "boolean"
              },
              "approved": {
                "type": "boolean"
              },
              "params": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "ingest_dry_run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "dry_run",
        "source_id",
        "page",
        "signals",
        "created_claims",
        "redacted",
        "would_write",
        "review_required",
        "apply_instruction"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "dry_run": {
          "const": true
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redacted": {
          "type": "boolean"
        },
        "would_write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "const": true
        },
        "apply_instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingest_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "source_id",
        "page",
        "signals",
        "created_claims",
        "redacted"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "import_check_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "line"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "import_check_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "error"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "import_check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "file",
        "checked",
        "accepted_count",
        "rejected_count",
        "error_count",
        "fail_on_rejected",
        "accepted",
        "rejected",
        "errors"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_on_rejected": {
          "type": "boolean"
        },
        "accepted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_check_item"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_check_item"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_check_error"
          }
        }
      }
    },
    "import_apply_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "file",
        "dry_run",
        "applied",
        "checked",
        "accepted_count",
        "rejected_count",
        "error_count",
        "would_write",
        "skipped_existing"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "file": { "type": "string", "minLength": 1 },
        "dry_run": { "type": "boolean" },
        "applied": { "type": "boolean" },
        "checked": { "type": "integer", "minimum": 0 },
        "accepted_count": { "type": "integer", "minimum": 0 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "would_write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "claims"],
          "properties": {
            "sources": { "type": "array", "items": { "type": "string" } },
            "claims": { "type": "array", "items": { "type": "string" } }
          }
        },
        "skipped_existing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "claims"],
          "properties": {
            "sources": { "type": "array", "items": { "type": "string" } },
            "claims": { "type": "array", "items": { "type": "string" } }
          }
        },
        "accepted": { "type": "array", "items": { "$ref": "#/$defs/import_check_item" } },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/import_check_item" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/import_check_error" } },
        "review_required": { "type": "boolean" },
        "apply_instruction": { "type": "string" }
      }
    },
    "crystallize_session_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "apply",
        "summary",
        "page",
        "source_id",
        "created_claims",
        "skipped_claims"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "apply": {
          "type": "boolean"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decisions",
            "actions",
            "blockers",
            "preferences",
            "questions",
            "files"
          ],
          "properties": {
            "decisions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "preferences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "created_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "context_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "generated_at",
        "items",
        "warnings"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context_item"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "search_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "backend",
        "results"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "fts_query": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/search_result_row"
          }
        }
      }
    },
    "status_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "claims",
        "sources",
        "pages",
        "initialized",
        "card",
        "entrypoint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "initialized": {
          "type": "boolean"
        },
        "card": {
          "type": "boolean"
        },
        "entrypoint": {
          "type": "boolean"
        }
      }
    },
    "index_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "db",
        "rows",
        "indexed",
        "skipped",
        "removed",
        "incremental",
        "indexed_keys",
        "skipped_keys",
        "removed_keys"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "db": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "incremental": {
          "type": "boolean"
        },
        "indexed_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cite_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "evidence",
        "status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "count"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audit_event"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "export_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "akbp_version",
        "exported_at",
        "card",
        "claims",
        "sources",
        "entities",
        "relations",
        "manifest"
      ],
      "properties": {
        "akbp_version": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "minLength": 1
        },
        "card": {
          "type": "object",
          "additionalProperties": true
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exported_claim"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_result"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_result"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_result"
          }
        },
        "manifest": {
          "$ref": "#/$defs/export_manifest"
        }
      }
    },
    "context_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "summary",
        "score",
        "citations",
        "freshness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness": {
          "type": "string"
        }
      }
    },
    "search_result_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "path",
        "snippet",
        "rank"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "snippet": {
          "type": "string"
        },
        "rank": {
          "type": "number"
        }
      }
    },

    "export_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "created_at", "producer", "artifact_paths", "artifact_hashes", "counts", "safety", "verification"],
      "properties": {
        "format": { "type": "string", "const": "akbp-portable-bundle" },
        "format_version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "artifact_paths": {
          "type": "object",
          "required": ["card", "claims", "sources", "entities", "relations"],
          "additionalProperties": { "type": "string" }
        },
        "artifact_hashes": {
          "type": "object",
          "required": ["card", "claims", "sources", "entities", "relations"],
